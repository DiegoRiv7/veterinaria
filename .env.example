# Database
# Local dev: a relative SQLite file
# Production (Turso): libsql://YOUR-DB-NAME-YOUR-ORG.turso.io
DATABASE_URL="file:./dev.db"

# Only required for Turso (paste the auth token from `turso db tokens create`)
DATABASE_AUTH_TOKEN=""

# Session signing secret — replace with a strong random string in production
# Generate with: openssl rand -hex 32
AUTH_SECRET="dev-insecure-secret-change-in-production-please"
